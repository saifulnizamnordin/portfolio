---
import Layout from "@/layouts/Layout.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import PostList from "@/components/PostList.astro"
import { Footer } from "@/components/Sections"
import { getPosts } from "@/lib/blog"
import { profile } from "@/data/profile"

const posts = await getPosts()
---

<Layout title={`Blog — ${profile.name}`} description="Notes on DevOps, CI/CD, infrastructure and building things.">
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-4">
    <section class="pt-12 pb-8 sm:pt-16">
      <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase">Blog</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight sm:text-4xl">Notes & write-ups</h1>
      <p class="mt-3 text-muted-foreground">DevOps, CI/CD, infrastructure and the things I build along the way.</p>
    </section>
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="text-muted-foreground">No posts yet.</p>}
    <Footer />
  </main>
</Layout>
