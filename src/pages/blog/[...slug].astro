---
import { render } from "astro:content"
import { ArrowLeft } from "lucide-react"
import Layout from "@/layouts/Layout.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import { Footer } from "@/components/Sections"
import { formatDate, getPosts, readingTime, type Post } from "@/lib/blog"
import { profile } from "@/data/profile"

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props as { post: Post }
const { Content } = await render(post)
const { title, description, pubDate, updatedDate, tags } = post.data
---

<Layout title={`${title} — ${profile.name}`} description={description}>
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-4">
    <article class="pt-10 sm:pt-14">
      <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground">
        <ArrowLeft className="size-4" /> All posts
      </a>
      <header class="mt-6 mb-10 space-y-3">
        <p class="text-sm text-muted-foreground tabular-nums">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <span> · Updated {formatDate(updatedDate)}</span>}
          <span> · {readingTime(post.body)}</span>
        </p>
        <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h1>
        <p class="text-lg text-muted-foreground">{description}</p>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <span class="rounded-full bg-secondary px-2 py-0.5 text-xs text-secondary-foreground">{tag}</span>
            ))}
          </div>
        )}
      </header>
      <div class="prose prose-neutral max-w-none dark:prose-invert prose-headings:tracking-tight prose-a:underline-offset-4 prose-pre:rounded-lg prose-code:before:content-none prose-code:after:content-none">
        <Content />
      </div>
    </article>
    <Footer />
  </main>
</Layout>
