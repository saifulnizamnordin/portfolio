---
import Layout from "@/layouts/Layout.astro"
import Experience from "@/components/Experience"
import SiteHeader from "@/components/SiteHeader.astro"
import PostList from "@/components/PostList.astro"
import { getPosts } from "@/lib/blog"
import DevOpsShowcase from "@/components/showcase/DevOpsShowcase"
import { About, Education, Footer, Hero, SectionHeading, Skills } from "@/components/Sections"
import { Separator } from "@/components/ui/separator"
import { experience, profile } from "@/data/profile"

const posts = (await getPosts()).slice(0, 3)
---

<Layout
  title={`${profile.name} — ${profile.headline}`}
  description="Senior Design Engineer and Cloud & DevOps engineer based in Malaysia. CI/CD, Kubernetes, multi-cloud infrastructure, FPGA tooling and C++/Qt."
>
  <SiteHeader />

  <main class="mx-auto max-w-3xl px-4">
    <Hero />

    <Separator className="my-12" />
    <section>
      <SectionHeading id="about" eyebrow="01" title="About me" />
      <About />
    </section>

    <Separator className="my-12" />
    <section>
      <SectionHeading id="portfolio" eyebrow="02" title="Portfolio" />
      <DevOpsShowcase client:visible />
    </section>

    <Separator className="my-12" />
    <section>
      <SectionHeading id="experience" eyebrow="03" title="Experience" />
      <Experience client:visible items={experience} />
    </section>

    <Separator className="my-12" />
    <section>
      <SectionHeading id="skills" eyebrow="04" title="Skills" />
      <Skills />
    </section>

    <Separator className="my-12" />
    <section>
      <SectionHeading id="education" eyebrow="05" title="Education & Certifications" />
      <Education />
    </section>

    <Separator className="my-12" />
    <section>
      <div class="flex items-end justify-between gap-4">
        <SectionHeading id="blog" eyebrow="06" title="Blog" />
        <a href="/blog/" class="mb-6 shrink-0 text-sm text-muted-foreground hover:text-foreground">View all posts →</a>
      </div>
      <PostList posts={posts} />
    </section>

    <Footer />
  </main>
</Layout>
