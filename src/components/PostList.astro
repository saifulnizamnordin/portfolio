---
import { formatDate, readingTime, type Post } from "@/lib/blog"

interface Props {
  posts: Post[]
}

const { posts } = Astro.props
---

<ul class="divide-y rounded-xl border">
  {posts.map((post) => (
    <li>
      <a href={`/blog/${post.id}/`} class="group block px-4 py-4 transition-colors hover:bg-muted/50 sm:px-5">
        <p class="text-xs text-muted-foreground tabular-nums">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span> · {readingTime(post.body)}</span>
        </p>
        <h3 class="mt-1 font-medium group-hover:underline group-hover:underline-offset-4">{post.data.title}</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="mt-2.5 flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => (
              <span class="rounded-full bg-secondary px-2 py-0.5 text-xs text-secondary-foreground">{tag}</span>
            ))}
          </div>
        )}
      </a>
    </li>
  ))}
</ul>
