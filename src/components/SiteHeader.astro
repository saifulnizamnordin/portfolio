---
import ThemeToggle from "@/components/ThemeToggle"
import { profile } from "@/data/profile"

const nav = [
  { href: "/blog/", label: "Blog" },
  { href: "/#about", label: "About" },
  { href: "/#portfolio", label: "Portfolio" },
  { href: "/#experience", label: "Experience" },
  { href: "/#skills", label: "Skills" },
  { href: "/#education", label: "Education" },
]
const onBlog = Astro.url.pathname.startsWith("/blog")
---

<header class="sticky top-0 z-10 border-b bg-background/80 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4">
    <a href="/" class="font-semibold tracking-tight">{profile.shortName}</a>
    <nav class="flex items-center gap-1 text-sm">
      {nav.map((item) => {
        const isBlog = item.href === "/blog/"
        return (
          <a
            href={item.href}
            aria-current={isBlog && onBlog ? "page" : undefined}
            class:list={[
              "rounded-md px-2.5 py-1.5 text-muted-foreground hover:bg-muted hover:text-foreground aria-[current=page]:text-foreground",
              isBlog ? "inline-block" : "hidden sm:inline-block",
            ]}
          >
            {item.label}
          </a>
        )
      })}
      <ThemeToggle client:load />
    </nav>
  </div>
</header>
